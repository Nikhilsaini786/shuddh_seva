# ====================================================================
# Shuddh Seva Foods — Environment Configuration
# ====================================================================
# Copy this file to .env and replace placeholder values with your real credentials.
# Command to copy: copy .env.example .env (Windows PowerShell)

# ----------------- FLASK CORE CONFIGURATION ----------------- #
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace_with_a_secure_random_hex_string_such_as_openssl_rand_hex_32

# ----------------- ADMIN DASHBOARD CONFIGURATION ----------------- #
# Store owner Ankit's details
ADMIN_NAME=Ankit
ADMIN_EMAIL=infosevaspice@gmail.com
ADMIN_PHONE=6350474290
# Strong admin password (default: Shuddh@Admin2026!)
ADMIN_PASSWORD=Shuddh@Admin2026!

# ----------------- GMAIL SMTP CONFIGURATION (FOR EMAIL OTP) ----------------- #
# To generate a Gmail App Password:
# 1. Open Google Account -> Security (https://myaccount.google.com/security)
# 2. Turn on 2-Step Verification if not already enabled.
# 3. Search for "App passwords" -> Create app name: "Shuddh Seva Website"
# 4. Copy the generated 16-character password into SMTP_PASSWORD below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=infosevaspice@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password_here
SMTP_FROM_NAME=Shuddh Seva Foods

# ----------------- TWILIO SMS CONFIGURATION (FOR MOBILE OTP) ----------------- #
# Obtain these from your Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ----------------- STORE & PAYMENT SETTINGS ----------------- #
STORE_NAME=Shuddh Seva Foods
STORE_PHONE=+91 6350474290
STORE_EMAIL=infosevaspice@gmail.com
UPI_ID=6350474290@paytm
FREE_DELIVERY_MIN=499
